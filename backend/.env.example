# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=job_tracker_db
DB_SYNCHRONIZE=true
DB_LOGGING=true

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=super_secret_jwt_access_key_2026_change_in_production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_2026_change_in_production
JWT_REFRESH_EXPIRATION=7d

# File Storage
UPLOAD_DEST=./uploads/documents
MAX_FILE_SIZE_MB=10

# Email (SMTP / Nodemailer)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="Job Application Tracker <noreply@jobtracker.local>"
